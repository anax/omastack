	optdepends = mkcert: Automated trusted local SSL certificate generation
	optdepends = rofi: Interactive application launcher menu
	optdepends = walker: Fast application launcher runner
	optdepends = waybar: Status bar module integration
	optdepends = libnotify: Desktop notification alerts

pkgname = omastack
