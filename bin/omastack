#!/usr/bin/env bash
# OmaStack Root Binary Forwarder
# SPDX-License-Identifier: MIT
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -x "${SCRIPT_DIR}/omastack/bin/omastack" ]; then
    exec "${SCRIPT_DIR}/omastack/bin/omastack" "$@"
elif [ -x "${SCRIPT_DIR}/runner.sh" ]; then
    exec "${SCRIPT_DIR}/runner.sh" "$@"
fi

echo "Error: Cannot locate omastack main binary" >&2
exit 1
