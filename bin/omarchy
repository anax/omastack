#!/usr/bin/env bash
# OmaStack Omarchy CLI Forwarder
# SPDX-License-Identifier: MIT
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -x "${SCRIPT_DIR}/omastack/bin/omarchy" ]; then
    exec "${SCRIPT_DIR}/omastack/bin/omarchy" "$@"
fi

echo "Error: Cannot locate omarchy binary" >&2
exit 1
