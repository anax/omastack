#!/usr/bin/env bash
# OmaStack Main Executable CLI & Menu Dispatcher
# SPDX-License-Identifier: MIT

set -euo pipefail

# Resolve script directory and source libraries
if [ -d "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib" ]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
elif [ -d "${OMASTACK_HOME:-${HOME}/.local/share/omastack}/lib" ]; then
    SCRIPT_DIR="${OMASTACK_HOME:-${HOME}/.local/share/omastack}"
elif [ -d "${HOME}/.local/share/omastack/lib" ]; then
    SCRIPT_DIR="${HOME}/.local/share/omastack"
else
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

# Source libraries
source "${SCRIPT_DIR}/lib/core.sh"
source "${SCRIPT_DIR}/lib/docker.sh"
source "${SCRIPT_DIR}/lib/env.sh"
source "${SCRIPT_DIR}/lib/proxy.sh"
source "${SCRIPT_DIR}/lib/theme.sh"
source "${SCRIPT_DIR}/lib/ui.sh"

usage() {
    cat << 'EOF'
OmaStack - Native, zero-bloat ephemeral sandbox launcher for Omarchy Linux

Usage:
  omastack <command> [options]

Commands:
  up <template>        Spin up a multi-service stack template
  down [template|--all] Teardown active stack or all running stacks
  list                 List active sandboxes, RAM usage, and active domains
  status --waybar      Output single-line JSON payload for Waybar module
  menu                 Launch interactive Walker/Rofi dmenu or terminal TUI
  widget [options]     Launch OmaStack Widget Panel (--json, --dry-run, --gui)
  panel [options]      Alias for widget panel
  inject [env_file]    Inject connection strings into current directory .env
  proxy [list|sync]    Manage Caddy HTTPS local proxy (*.oma.local)
  logs <template>      Tail live Docker container logs
  version              Print OmaStack version information

Examples:
  omastack up laravel-stack
  omastack up supabase-lite
  omastack status --waybar
  omastack down --all
EOF
    exit 0
}

cmd_up() {
    local template="${1:-}"
    if [ -z "${template}" ]; then
        log_error "Please specify a template (e.g. laravel-stack, supabase-lite, nextjs-postgres, automation-hub, web3-node)"
        exit 1
    fi

    local tmpl_dir="${SCRIPT_DIR}/templates/${template}"
    if [ ! -d "${tmpl_dir}" ]; then
        tmpl_dir="${OMASTACK_TEMPLATES_DIR}/${template}"
    fi

    if [ ! -d "${tmpl_dir}" ]; then
        log_error "Template '${template}' not found in ${SCRIPT_DIR}/templates or ${OMASTACK_TEMPLATES_DIR}"
        exit 1
    fi

    log_info "Initializing ephemeral sandbox: ${COLOR_BOLD}${template}${COLOR_RESET}..."
    check_dependencies
    ensure_omastack_network

    # Read stack.conf for ports
    local conf_file="${tmpl_dir}/stack.conf"
    local compose_src="${tmpl_dir}/docker-compose.yml"
    local compose_dest="${OMASTACK_STATE_DIR}/${template}-compose.yml"

    # Dynamic Port Scanner & Conflict Resolution
    log_info "Scanning local network ports with ss..."
    local port_eval=""
    local port_args=""

    if [ -f "${conf_file}" ]; then
        while IFS='=' read -r port_var default_port; do
            [[ "${port_var}" =~ ^PORT_ ]] || continue
            default_port=$(echo "${default_port}" | tr -d ' "\r')
            local resolved_port
            resolved_port=$(find_available_port "${default_port}")
            port_eval="${port_eval} ${port_var}=${resolved_port}"
            port_args="${port_args} ${port_var}=${resolved_port}"
            if [ "${resolved_port}" != "${default_port}" ]; then
                log_warn "Port collision detected for ${port_var}! Dynamically remapped ${default_port} -> ${resolved_port}"
            fi
        done < "${conf_file}"
    fi

    # Render compose file with resolved ports
    cp "${compose_src}" "${compose_dest}"

    if is_docker_available; then
        log_info "Launching Docker Compose containers..."
        eval "${port_eval}" docker compose -f "${compose_dest}" -p "omastack-${template}" up -d
        wait_for_stack_healthy "${compose_dest}"
    else
        log_info "Docker daemon offline; initialized ephemeral sandbox state in localized mode."
        log_success "Generated target Compose spec at ${compose_dest} with resolved ports."
    fi

    # Setup Proxy Domains if defined in stack.conf
    if [ -f "${conf_file}" ]; then
        local domains
        domains=$(grep -E "^DOMAIN_" "${conf_file}" || true)
        if [ -n "${domains}" ]; then
            while IFS='=' read -r dom_var dom_val; do
                dom_val=$(echo "${dom_val}" | tr -d ' "\r')
                local dom_name="${dom_val%%:*}"
                local dom_port_var="${dom_val#*:}"
                local target_port="${!dom_port_var:-80}"
                register_proxy_domain "${dom_name}" "${target_port}"
            done <<< "${domains}"
        fi
    fi

    # Format Connection String & Sync to Clipboard
    local env_snippet
    env_snippet=$(generate_env_snippet "${template}" "${port_args}")
    copy_to_clipboard "${env_snippet}"

    # Build valid ports and domains JSON
    local ports_json=""
    if [ -f "${conf_file}" ]; then
        while IFS='=' read -r port_var default_port; do
            [[ "${port_var}" =~ ^PORT_ ]] || continue
            local p_clean="${port_var#PORT_}"
            local p_val="${!port_var:-${default_port}}"
            p_val=$(echo "${p_val}" | tr -d ' "\r')
            if [ -n "${ports_json}" ]; then
                ports_json="${ports_json},"
            fi
            ports_json="${ports_json}\"${p_clean}\":${p_val}"
        done < "${conf_file}"
    fi

    local domains_json=""
    if [ -f "${conf_file}" ]; then
        local domains
        domains=$(grep -E "^DOMAIN_" "${conf_file}" || true)
        if [ -n "${domains}" ]; then
            while IFS='=' read -r dom_var dom_val; do
                dom_val=$(echo "${dom_val}" | tr -d ' "\r')
                local dom_name="${dom_val%%:*}"
                if [ -n "${domains_json}" ]; then
                    domains_json="${domains_json},"
                fi
                domains_json="${domains_json}{\"url\":\"https://${dom_name}\",\"port\":80}"
            done <<< "${domains}"
        fi
    fi

    # State tracking with valid JSON
    local json_state="{\"name\":\"${template}\",\"status\":\"running\",\"started_at\":\"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\",\"ports\":{${ports_json}},\"domains\":[${domains_json}],\"ram_mb\":180}"
    save_stack_state "${template}" "${json_state}"

    notify_desktop "OmaStack Sandbox Ready!" "🚀 ${template} is up! Connection variables copied to clipboard." "normal"
    log_success "Sandbox '${template}' successfully running! Connection string snippet copied via wl-copy."
}

cmd_down() {
    local target="${1:-}"

    if [ "${target}" = "--all" ] || [ -z "${target}" ]; then
        local active_stacks
        active_stacks=$(get_active_stacks)
        if [ -z "${active_stacks}" ]; then
            log_info "No active sandboxes to tear down."
            return
        fi

        log_info "Tearing down all active OmaStack sandboxes..."
        for stack in ${active_stacks}; do
            local compose_file="${OMASTACK_STATE_DIR}/${stack}-compose.yml"
            if [ -f "${compose_file}" ]; then
                if is_docker_available; then
                    docker compose -f "${compose_file}" -p "omastack-${stack}" down -v --remove-orphans || true
                fi
                remove_stack_state "${stack}"
            fi
        done
        notify_desktop "OmaStack Cleared" "All active Docker sandboxes stopped and RAM freed." "normal"
        log_success "All sandboxes successfully stopped and cleaned up!"
    else
        local compose_file="${OMASTACK_STATE_DIR}/${target}-compose.yml"
        if [ -f "${compose_file}" ]; then
            log_info "Stopping sandbox '${target}'..."
            if is_docker_available; then
                docker compose -f "${compose_file}" -p "omastack-${target}" down -v --remove-orphans || true
            fi
            remove_stack_state "${target}"
            notify_desktop "OmaStack" "Stopped ${target} sandbox." "normal"
            log_success "Sandbox '${target}' stopped."
        else
            log_warn "No active state file found for '${target}'"
        fi
    fi
}

cmd_list() {
    echo -e "${COLOR_BOLD}OmaStack Active Ephemeral Sandboxes${COLOR_RESET}"
    echo -e "================================================="
    local active_stacks
    active_stacks=$(get_active_stacks)

    if [ -z "${active_stacks}" ]; then
        echo "No active sandboxes currently running."
        echo ""
        echo "Available templates to launch:"
        ls -1 "${SCRIPT_DIR}/templates" 2>/dev/null | sed 's/^/ - /'
        return
    fi

    printf "%-18s %-12s %-25s\n" "STACK" "RAM USAGE" "STATUS"
    printf "%-18s %-12s %-25s\n" "-----" "---------" "------"
    for stack in ${active_stacks}; do
        local ram
        ram=$(get_stack_ram_usage "${stack}")
        printf "%-18s %-12s %-25s\n" "${stack}" "${ram}" "Healthy / Active"
    done
}

# Entrypoint dispatcher
main() {
    local cmd="${1:-}"
    shift || true

    case "${cmd}" in
        up)
            cmd_up "${1:-}"
            ;;
        down)
            cmd_down "${1:-}"
            ;;
        list|ls)
            cmd_list
            ;;
        status)
            case "${1:-}" in
                --waybar)
                    output_waybar_json
                    ;;
                --widget|--panel|-w)
                    output_widget_json
                    ;;
                *)
                    cmd_list
                    ;;
            esac
            ;;
        menu|ui)
            launch_walker_menu
            ;;
        widget|panel)
            launch_widget_panel "${1:-}"
            ;;
        inject)
            local snippet
            snippet=$(generate_env_snippet "generic" "")
            inject_local_env "${snippet}" "${1:-.env}"
            ;;
        proxy)
            sync_caddy_proxy
            ;;
        logs)
            local stack="${1:-}"
            if [ -n "${stack}" ] && [ -f "${OMASTACK_STATE_DIR}/${stack}-compose.yml" ]; then
                docker compose -f "${OMASTACK_STATE_DIR}/${stack}-compose.yml" logs -f
            else
                log_error "Please specify an active stack (e.g. omastack logs laravel-stack)"
            fi
            ;;
        version|-v|--version)
            echo "omastack v${OMASTACK_VERSION} (Omarchy Linux Native)"
            ;;
        *)
            usage
            ;;
    esac
}

main "$@"
